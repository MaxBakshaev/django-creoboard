# CreoBoard — пример переменных окружения.
# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ коммитить.
# Секретный ключ:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# ---------- Django ----------
# Разработка: config.settings.dev, сервер: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
# На сервере: путь админки лучше сделать нестандартным
DJANGO_ADMIN_URL=admin/
# Лимит попыток входа (на IP и на логин). Счётчики локальны для процесса gunicorn,
# поэтому реальный лимит до числа воркеров раз выше; строгий лимит ставит nginx limit_req.
LOGIN_THROTTLE_IP=5/min
LOGIN_THROTTLE_USER=5/min
# Сколько прокси стоит перед приложением (для определения IP клиента). Dev: 0, сервер: 2.
DJANGO_NUM_PROXIES=0

# ---------- База данных ----------
POSTGRES_DB=creoboard
POSTGRES_USER=creoboard
POSTGRES_PASSWORD=change-me
# Порт БД на хосте (5432 часто занят локальным PostgreSQL)
POSTGRES_PORT=5433
# Локально (БД в Docker, backend на хосте):
DATABASE_URL=postgres://creoboard:change-me@127.0.0.1:5433/creoboard
# На сервере хост БД — имя сервиса compose:
# DATABASE_URL=postgres://creoboard:<пароль>@db:5432/creoboard

# ---------- Файлы ----------
MAX_UPLOAD_MB=100

# ---------- Демо ----------
# Демо-пользователи создаются только при DEMO_MODE=1
DEMO_MODE=1
DEMO_PASSWORD=change-me

# ---------- Деплой (только на сервере) ----------
# Prod-значения: DJANGO_SETTINGS_MODULE=config.settings.prod, DJANGO_DEBUG=0,
# DJANGO_ALLOWED_HOSTS=<поддомен сервиса>, DJANGO_CSRF_TRUSTED_ORIGINS=https://<поддомен сервиса>
WEB_PORT=8080
GHCR_OWNER=maxbakshaev
IMAGE_TAG=latest
